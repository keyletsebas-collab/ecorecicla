<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciminsaApp.MainPage">

    <!-- Contenedor nativo de la app web (Resources: wwwroot/index.html).
         HybridWebView reemplaza a BlazorWebView: no hay componentes Razor. -->
    <HybridWebView x:Name="hybridWebView"
                   HybridRoot="wwwroot"
                   DefaultFile="index.html"
                   RawMessageReceived="OnRawMessageReceived"
                   WebViewInitialized="OnWebViewInitialized" />

</ContentPage>
