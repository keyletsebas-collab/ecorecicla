{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ReciminsaApp (Windows)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/ReciminsaApp/bin/Debug/net10.0-windows10.0.19041.0/win-x64/ReciminsaApp.exe",
            "args": [],
            "cwd": "${workspaceFolder}/ReciminsaApp",
            "preLaunchTask": "build"
        },
        {
            "name": ".NET MAUI (Meteor)",
            "type": "dotnet-meteor.debugger",
            "request": "launch",
            "preLaunchTask": "build"
        },
        {
            "name": "Electron Main",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
            },
            "args": [
                "."
            ]
        }
    ]
}
