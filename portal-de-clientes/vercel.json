{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "portal.css",
      "use": "@vercel/static"
    },
    {
      "src": "portal.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/portal.css",
      "dest": "portal.css"
    },
    {
      "src": "/portal.js",
      "dest": "portal.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
